    ],
    "queries": [
      "SELECT s.ra, s.dec, ph.psfMag_g, ph.psfMag_r, p.elodiervfinal, p.elodiervfinalerr, p.teffadop, p.teffadopunc, p.loggadop, p.loggadopunc, p.fehadop, p.fehadopunc, p.snr FROM dbo.fGetNearbySpecObjEq(114.602,21.575,30) AS nb JOIN sppParams AS p ON p.specobjid = nb.specObjID JOIN SpecObj AS s ON s.specobjid = p.specobjid LEFT JOIN PhotoObj AS ph ON ph.objid = p.bestobjid WHERE p.teffadop > 0 AND p.seguePrimary = 1 ORDER BY p.specobjid",
      "SELECT COUNT(*) AS spectra, SUM(CASE WHEN p.seguePrimary = 1 THEN 1 ELSE 0 END) AS primaryOnes, SUM(CASE WHEN p.seguePrimary = 1 AND p.teffadop > 0 THEN 1 ELSE 0 END) AS kept FROM dbo.fGetNearbySpecObjEq(114.602,21.575,30) AS nb JOIN sppParams AS p ON p.specobjid = nb.specObjID"
