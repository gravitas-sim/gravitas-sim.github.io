  "offline": { "policy": "precache" },
  "validation": [
    { "check": "registry:spectra-structure" },
    { "check": "registry:spectra-provenance" },
    { "check": "jest:tests/stellarSpectra.test.js" },
    { "check": "e2e:e2e/stellarSpectra.spec.js" }
