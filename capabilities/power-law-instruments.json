{
  "format": "gravitas.capability-package",
  "formatVersion": 1,
  "id": "gravitas.power-law-instruments",
  "version": "1.0.0",
  "kind": "built-in",
  "gravitas": "^1.0.0",
  "title": {
    "en": "Power-law gravity instruments",
    "es": "Instrumentos de gravedad en ley de potencias"
  },
  "provides": {
    "models": [
      {
        "id": "power-law-gravity-model",
        "entry": "builtin:model/power-law-gravity"
      }
    ],
    "widgetFamilies": [
      {
        "id": "power-law",
        "entry": "builtin:widgets/power-law",
        "pick": "POWER_LAW_WIDGETS",
        "widgets": [
          "power-law-precession",
          "power-law-refinement",
          "power-law-kepler",
          "power-law-conservation"
        ]
      }
    ]
  },
  "assets": [
    { "path": "js/powerLawWidgets.js", "role": "code", "offline": "core" },
    { "path": "js/powerLawLab.js", "role": "code", "offline": "core" },
    { "path": "js/powerLawGravity.js", "role": "code", "offline": "core" }
  ],
  "citations": [],
  "licenses": [{ "scope": "js/powerLaw*.js", "license": "MIT" }],
  "offline": { "policy": "precache" },
  "authoring": { "checks": ["registry:author"] },
  "validation": [
    { "check": "jest:tests/powerLawGravity.test.js" },
    { "check": "jest:tests/lazyWidgets.test.js" },
    { "check": "e2e:e2e/lazyInstruments.spec.js" }
  ],
  "migrations": []
}
