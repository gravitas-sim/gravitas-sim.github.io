{
  "format": "gravitas.capability-package",
  "formatVersion": 1,
  "id": "gravitas.lab3d",
  "version": "1.0.0",
  "kind": "built-in",
  "gravitas": "^1.0.0",
  "title": {
    "en": "The 3-D small-N dynamics kernel",
    "es": "El núcleo de dinámica de pocos cuerpos en 3-D"
  },
  "provides": {
    "routes": [
      {
        "path": "/lab3d/"
