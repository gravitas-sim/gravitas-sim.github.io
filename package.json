{
  "name": "gravitas-sim.github.io",
  "version": "1.0.0",
  "description": "An interactive astrophysics sandbox and astronomy teaching tool that runs entirely in the browser.",
  "main": "index.js",
  "scripts": {
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "test:verbose": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --verbose",
    "lint": "eslint js tools e2e build.js playwright.config.js eslint.config.js",
    "lint:fix": "eslint js tools e2e build.js playwright.config.js eslint.config.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"tools/**/*.{js,mjs}\" \"e2e/**/*.js\" \"tests/**/*.js\" playwright.config.js eslint.config.js build.js",
    "format:check": "prettier --check \"js/**/*.js\" \"tools/**/*.{js,mjs}\" \"e2e/**/*.js\" \"tests/**/*.js\" playwright.config.js eslint.config.js build.js",
    "dev": "npx http-server . -p 8003 -o",
    "serve": "npx http-server . -p 8003",
    "build": "node tools/make-social-card.js && node tools/build-instructor-materials.js && node build.js",
    "build:watch": "node build.js --watch",
    "preview": "npm run build && npx http-server dist -p 8004 -o",
    "social-card": "node tools/make-social-card.js",
    "build:instructors": "node tools/build-instructor-materials.js",
    "build:ci": "node tools/make-social-card.js && node tools/build-instructor-materials.js --unpublishable && node build.js",
    "thumbnails": "node tools/generate-scenario-thumbnails.mjs",
    "thumbnails:check": "node tools/generate-scenario-thumbnails.mjs --check",
    "perf": "node tools/perf-probe.mjs",
    "validate:physics": "node tools/validate-physics.mjs",
    "validate:scenarios": "node tools/scenario-stability.mjs",
    "validation:data": "node tools/build-validation-data.mjs",
    "validate:links": "node tools/check-links.mjs",
    "serve:dist": "node tools/static-server.mjs --root dist --port 4173",
    "e2e": "playwright test",
    "e2e:dist": "GRAVITAS_E2E_TARGET=dist GRAVITAS_E2E_PORT=4174 playwright test",
    "e2e:all": "npm run e2e && npm run e2e:dist",
    "e2e:browsers": "GRAVITAS_E2E_BROWSERS=all playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravitas-sim/gravitas-sim.github.io.git"
  },
  "keywords": [],
  "author": "Carl Ziegler",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/gravitas-sim/gravitas-sim.github.io/issues"
  },
  "homepage": "https://github.com/gravitas-sim/gravitas-sim.github.io#readme",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@jest/globals": "^30.0.4",
    "@playwright/test": "1.62.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
