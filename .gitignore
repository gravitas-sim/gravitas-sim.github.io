# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# IDE and local tooling
.vscode/
.idea/
*.swp
*.swo
# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Logs
*.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
*.tmp
*.temp 
# Instructor materials: the passphrase and the plaintext PDFs
.instructor-password
.instructor-build/
.instructor-fixture/

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# LaTeX build products. manual/*.tex and the PDF at the repository root are
# committed; the compiler's intermediates are not.
manual/*.log
manual/*.aux
manual/*.out
manual/*.toc
manual/*.xdv
manual/gravitas-user-manual.pdf
.build-report.json

# Cached GWOSC downloads for tools/build-gw-data.mjs. The processed result
# is committed; the 1.4 MB of source text is not.
.gw-cache/

# Cached MIST downloads for tools/build-stellar-tracks.mjs. The reduced result
# is committed; the 100 MB source grid is not.
.mist-cache/

# Cached SDSS spectrum CSVs. `npm run spectra:data` refills this; the
# committed js/data/spectra/sdssSpectra.js is what ships.
.sdss-cache/

# Cached GWOSC 32-second strain files. `npm run gwosc:data` refills this; the
# committed js/data/gw/gwoscEvents.js is what ships.
.gwosc-cache/

# Reports an earlier CI step left for tools/docs-facts.mjs to read back.
.facts/
