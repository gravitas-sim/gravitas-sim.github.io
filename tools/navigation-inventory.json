{
  "format": "gravitas.navigation-inventory/1",
  "note": "The navigation model (NAVIGATION.md), the mapping of every surface into it, the ceilings the structural checks hold the site to, and the checks it fails today by design. tests/navigationChecks.test.js and e2e/navigation.spec.js read this file. A ceiling is lowered by the prompt that earns it; raising one needs a decision-register row. Nothing here is a user study: it proves structure, labels and reachability, not comprehension.",
  "hypothesis": "Explore, Learn, Observe, My work, Teach (Prompt 161 kept the working hypothesis of section 9.4: nothing in the audit contradicts it, see NAVIGATION.md).",
  "destinations": [
    {
      "id": "explore",
      "en": "Explore",
      "es": "Explorar",
      "says": {
        "en": "Build a system, load a scenario and change anything while it runs.",
        "es": "Construye un sistema, carga un escenario y cambia lo que quieras mientras se ejecuta."
      },
      "first": {
        "en": "Open the sandbox",
        "es": "Abrir la simulación libre",
        "path": "/",
        "selector": "#simulationCanvas"
      }
    },
    {
      "id": "learn",
      "en": "Learn",
      "es": "Aprender",
      "says": {
        "en": "Guided investigations, sequences and courses, each ending in a report you can hand in.",
        "es": "Investigaciones guiadas, secuencias y cursos, cada uno con un informe que puedes entregar."
      },
      "first": {
        "en": "Search the Library",
        "es": "Buscar en la Biblioteca",
        "path": "/library/",
        "selector": "#libSearch"
      }
    },
    {
      "id": "observe",
      "en": "Observe",
      "es": "Observar",
      "says": {
        "en": "Measure real and synthetic observations, and run experiments on the model.",
        "es": "Mide observaciones reales y sintéticas, y ejecuta experimentos con el modelo."
      },
      "first": {
        "en": "Open an observation",
        "es": "Abrir una observación",
        "path": "/observatory/",
        "selector": "#obsOpen"
      }
    },
    {
      "id": "my-work",
      "en": "My work",
      "es": "Mi trabajo",
      "says": {
        "en": "Everything you have made, kept on this device: progress, reports and backups.",
        "es": "Todo lo que has hecho, guardado en este dispositivo: progreso, informes y copias de seguridad."
      },
      "first": {
        "en": "Back up your work",
        "es": "Hacer una copia de tu trabajo",
        "path": "/my-work/",
        "selector": "#mwExport"
      }
    },
    {
      "id": "teach",
      "en": "Teach",
      "es": "Enseñar",
      "says": {
        "en": "Run Gravitas in a course: teaching materials, activities, answer keys and a quick start.",
        "es": "Usa Gravitas en un curso: materiales didácticos, actividades, claves de respuestas y un inicio rápido."
      },
      "first": {
        "en": "Start with the quick start",
        "es": "Empezar por el inicio rápido",
        "path": "/teaching/",
        "selector": "a[href=\"#path-start\"]"
      }
    }
  ],
