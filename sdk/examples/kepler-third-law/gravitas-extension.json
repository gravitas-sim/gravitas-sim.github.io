{
  "format": "gravitas.capability-package",
  "formatVersion": 1,
  "id": "example.kepler-third-law",
  "version": "1.0.0",
  "kind": "built-in",
  "gravitas": "^1.0.0",
  "title": {
    "en": "Kepler's third law, as one instrument",
    "es": "La tercera ley de Kepler, como un instrumento"
  },
  "provides": {
    "widgetFamilies": [
      {
        "id": "kepler-third-law",
        "widgets": [
          "third-law-period"
        ],
        "entry": "builtin:widgets/kepler-third-law"
      }
    ],
    "translations": [
      {
        "locale": "en",
        "file": "strings.en.json"
      },
      {
        "locale": "es",
        "file": "strings.es.json"
      }
    ]
  },
  "assets": [
    {
      "path": "keplerThirdLawWidgets.js",
      "role": "code",
      "offline": "core"
    },
    {
      "path": "strings.en.json",
      "role": "translation",
      "offline": "core"
    },
    {
      "path": "strings.es.json",
      "role": "translation",
      "offline": "locale"
    }
  ],
  "citations": [],
  "licenses": [
    {
      "scope": "*.js",
      "license": "MIT"
    },
    {
      "scope": "*.json",
      "license": "MIT"
    }
  ],
  "offline": {
    "policy": "precache"
  },
  "validation": [
    {
      "check": "jest:tests/sdkContract.test.js"
    }
  ],
  "migrations": []
}
