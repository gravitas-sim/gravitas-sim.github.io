      {
        "id": "orbits-first-week",
        "file": "course.json"
      }
    ]
  },
  "assets": [
    {
      "path": "course.json",
      "role": "data",
      "offline": "optional"
    }
  ],
  "citations": [],
  "licenses": [
    {
      "scope": "course.json",
      "license": "CC-BY-4.0"
    }
  ],
  "offline": {
    "policy": "precache"
  },
  "validation": [
    {
      "check": "registry:sdk-extensions"
    }
  ],
  "migrations": []
}
