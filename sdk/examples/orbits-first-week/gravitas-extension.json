{
  "format": "gravitas.capability-package",
  "formatVersion": 1,
  "id": "example.orbits-first-week",
  "version": "1.0.0",
  "kind": "declarative",
  "gravitas": "^1.0.0",
  "title": {
    "en": "Orbits: a first week, a course pack",
    "es": "Órbitas: una primera semana, un curso"
  },
  "provides": {
