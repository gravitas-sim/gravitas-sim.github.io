{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/image-marks-1.schema.json",
  "title": "gravitas.image-marks/1",
  "description": "The marks a reader placed on an image in the Observatory: the frames they were placed on (by SHA-256 digest and size, with an optional time), and each mark as placed (kind, tag, points in pixels, a known length for a reference pair) and, for a refined mark, the refined points and their uncertainty. It is `workspace.marks` of a gravitas.observation/1 and the `image-marks` reduction step of an artifact. js/measure/imageRecord.js validateMarks() is the authority; it also checks the number of points each kind needs, that a mark names a frame that is there, that ids are unique and that a refined result has as many points as the mark. Nothing here reads pixels. FORMATS.md lists it.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "frames",
    "marks"
  ],
  "properties": {
    "format": {
      "const": "gravitas.image-marks"
    },
    "formatVersion": {
      "const": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "digest",
          "width",
          "height"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "time": {
            "type": "object",
            "required": [
              "scale",
              "value"
            ],
            "properties": {
              "scale": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "mjd",
                  "jd",
                  "iso"
                ]
              },
              "value": {}
            }
          },
          "used": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "frame",
          "tag",
          "pts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "point",
              "count",
              "segment",
              "reference-pair",
              "circle",
              "polygon"
            ]
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "tag": {
            "type": "string",
            "maxLength": 40
          },
          "pts": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 1000
          },
          "length": {
            "type": "object",
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "object",
            "required": [
              "pts",
              "sigma"
            ],
            "properties": {
              "pts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "maxItems": 1000
              },
              "sigma": {
                "type": "number"
              }
            }
          }
        }
      },
      "maxItems": 2000
    }
  }
}
