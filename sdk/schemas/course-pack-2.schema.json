{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/course-pack-2.schema.json",
  "title": "gravitas.course-pack/2",
  "description": "A course as data, as the course-pack builder (/studio/course/) writes it: units of items (lessons, assignments cut from a lesson, scenarios, datasets, readings and investigation packs carried as links) with objectives, prerequisites, times, optional introductory and advanced paths, notes for the teacher and the student, and a pin on each lesson it names so an archived pack says what it was made with. Content only: nothing in it is run. js/course/pack.js validateCoursePack() is the authority; /1 packs (course-pack-1.schema.json) are migrated to this by migrateCoursePack(). Beyond this schema the reader holds every text to the file's own locales, the rules across items (see item), at most 120 items in all, and, before any rule reads it, a file to plain data no deeper or larger than any pack needs. FORMATS.md lists it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "gravitas",
    "locales",
    "pinning",
    "title",
    "units"
  ],
  "properties": {
    "format": {
      "const": "gravitas.course-pack"
    },
    "formatVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/publicId"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "gravitas": {
      "description": "The platform version the pack was made with.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "en",
          "es"
        ]
      },
      "contains": {
        "const": "en"
      }
    },
    "pinning": {
      "description": "exact: every lesson is pinned and any change needs review. compatible: only a change that can break does.",
      "enum": [
        "exact",
        "compatible"
      ]
    },
    "title": {
      "$ref": "#/$defs/text120"
    },
    "summary": {
      "$ref": "#/$defs/text2000"
    },
    "audience": {
      "$ref": "#/$defs/text300"
    },
    "teacherGuide": {
      "$ref": "#/$defs/text4000"
    },
    "objectives": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/publicId"
          },
          "text": {
            "$ref": "#/$defs/text300"
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lesson"
            ],
            "properties": {
              "lesson": {
                "$ref": "#/$defs/lesson"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text300"
              }
            }
          }
        ]
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "publicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "plain": {
      "description": "Course texts are written as text: no angle bracket and no entity.",
      "type": "string",
      "not": {
        "pattern": "[<>]|&[a-zA-Z#0-9]+;"
      }
    },
    "text120": {
      "description": "A text in plain words, up to 120 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 120,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 120
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "text200": {
      "description": "A text in plain words, up to 200 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 200,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 200
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "text300": {
      "description": "A text in plain words, up to 300 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 300,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 300
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "text1200": {
      "description": "A text in plain words, up to 1200 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 1200
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "text2000": {
      "description": "A text in plain words, up to 2000 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 2000
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "text4000": {
      "description": "A text in plain words, up to 4000 characters: no markup and no entity. The English is required and not blank; the Spanish and the digest of the English it was written from are optional. A key must be one of the file's own locales, which a schema cannot hold it to.",
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/plain",
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "es": {
          "$ref": "#/$defs/plain",
          "maxLength": 4000
        },
        "esOf": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "sid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "lesson": {
      "description": "A lesson Gravitas has: this build's.",
      "type": "string",
      "enum": [
        "keplers-laws",
        "retrograde-motion",
        "transit-photometry",
        "orbital-energy",
        "weighing-stars",
        "black-holes",
        "radial-velocity",
        "goldilocks-question",
        "missing-mass",
        "tides",
        "butterfly-effect",
        "when-orbits-lock",
        "detect-this-planet",
        "design-the-schedule",
        "binary-star-planets",
        "gravity-assist",
        "hohmann-transfer",
        "lagrange-points",
        "what-is-a-gravitational-wave",
        "listening-to-spacetime",
        "a-universe-of-stars",
        "lives-of-stars",
        "twelve-nights",
        "power-law-gravity",
        "color-and-temperature",
        "the-turning-sky",
        "the-sun-through-the-year",
        "phases-and-eclipses",
        "wanderers-on-the-sky",
        "plan-a-night"
      ]
    },
    "pkg": {
      "description": "The package a pinned lesson came from, and its version.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      ]
    },
    "pin": {
      "description": "What a lesson was when the pack named it: the digest of its steps, how many it had, and the package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fp",
        "n"
      ],
      "properties": {
        "fp": {
          "$ref": "#/$defs/hash"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "pkg": {
          "$ref": "#/$defs/pkg"
        }
      }
    },
    "assignmentPin": {
      "description": "A pin on an assignment: the same, and the digest of each assigned step, in order (one for each step: a rule across fields that the reader holds).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fp",
        "n",
        "f"
      ],
      "properties": {
        "fp": {
          "$ref": "#/$defs/hash"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "pkg": {
          "$ref": "#/$defs/pkg"
        },
        "f": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "itemLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "lesson"
      ],
      "properties": {
        "kind": {
          "const": "lesson"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "lesson": {
          "$ref": "#/$defs/lesson"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "depth": {
          "enum": [
            "core",
            "quantitative",
            "advanced"
          ],
          "description": "The depth the item is set at (Prompt 72); steps deeper than it are not shown."
        }
      }
    },
    "itemAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "lesson",
        "steps",
        "assignment"
      ],
      "properties": {
        "kind": {
          "const": "assignment"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "lesson": {
          "$ref": "#/$defs/lesson"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sid"
          }
        },
        "title": {
          "$ref": "#/$defs/text120"
        },
        "intro": {
          "$ref": "#/$defs/text1200"
        },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "created"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            },
            "created": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "pin": {
          "$ref": "#/$defs/assignmentPin"
        },
        "depth": {
          "enum": [
            "core",
            "quantitative",
            "advanced"
          ],
          "description": "The depth the item is set at (Prompt 72); steps deeper than it are not shown."
        }
      }
    },
    "itemScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scenario",
        "seed",
        "minutes"
      ],
      "properties": {
        "kind": {
          "const": "scenario"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "scenario": {
          "description": "A built-in scenario by its id, or by the English name a pack made before ids used.",
          "enum": [
            "solar-system",
            "retrograde-mars",
            "earth-moon-system",
            "trappist-1-system",
            "three-body-sensitivity-lab",
            "galilean-resonance",
