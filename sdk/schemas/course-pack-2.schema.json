            "spiral-galaxy",
            "milky-way-rotation",
            "coma-cluster",
            "exoplanet-characterization-lab",
            "blended-binary",
            "gravity-assist-lab",
            "gravity-assist-heliocentric",
            "lagrange-point-lab",
            "orbital-transfer-lab",
            "binary-planet-lab",
            "circumbinary-planet-lab",
            "black-hole-lab",
            "habitable-zone-lab",
            "keplers-2nd-law",
            "gw150914",
            "binary-bh",
