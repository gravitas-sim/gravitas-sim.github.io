    "itemDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "dataset",
        "minutes"
      ],
      "properties": {
        "kind": {
          "const": "dataset"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "dataset": {
          "description": "An observation the Observatory opens by name, or a data pack the catalog has: the validator's list, which a build with another catalog does not share.",
          "$ref": "#/$defs/publicId"
        },
        "title": {
          "$ref": "#/$defs/text120"
        }
      }
    },
    "cite": {
      "description": "Who wrote a reading, when and where. An address is https, with a host and no credentials, in the canonical form (js/course/pack.js safeUrl); the pattern states the shape and the reader holds the rest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "year",
        "source"
      ],
      "properties": {
        "authors": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S",
          "not": {
            "pattern": "[<>]"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1500,
          "maximum": 2100
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S",
          "not": {
            "pattern": "[<>]"
          }
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/[^\\s<>\"]{1,200}$"
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://[^\\s/@]+(/\\S*)?$"
        }
      }
    },
    "itemReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "cite",
        "access",
        "minutes"
      ],
      "properties": {
        "kind": {
          "const": "reading"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "title": {
          "$ref": "#/$defs/text200"
        },
        "cite": {
          "$ref": "#/$defs/cite"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "not": {
            "pattern": "[<>]"
          }
        },
        "access": {
          "enum": [
            "open",
            "library",
            "print"
          ]
        }
      }
    },
    "itemPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "pack",
        "version",
        "link"
      ],
      "properties": {
        "kind": {
          "const": "pack"
        },
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "path": {
          "enum": [
            "core",
            "intro",
            "advanced"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicId"
          }
        },
        "studentNote": {
          "$ref": "#/$defs/text1200"
        },
        "teacherNote": {
          "$ref": "#/$defs/text2000"
        },
        "pack": {
          "$ref": "#/$defs/publicId",
          "description": "The investigation pack's public id (its progress is kept under rx-<id>-<version>)."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "link": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4000,
          "pattern": "^i\\d{1,3}[zr][A-Za-z0-9_-]+$",
          "description": "The investigation as a link's fragment (the part after #, js/composer/packLink.js): a remix as its difference from the faithful copy of its original, a pack written from scratch whole. The reader opens it as the application does, judges it by the format and the remix rules, and compares the pin with the digest of its compiled steps."
        },
        "title": {
          "$ref": "#/$defs/text120"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        }
      },
      "description": "An investigation pack carried in the course as its link (Prompt 78). The pin is the digest of its compiled steps, as a lesson's is."
    },
    "item": {
      "description": "One thing a course asks of a student, of one of six kinds. Beyond this schema the reader holds the rules across fields: every id unique, an item's needs and objectives to ones that exist (and a path a student on its own path may take), a lesson named once as a lesson, a pin on every lesson in an exact pack, one step hash for each assigned step, and every reference to a lesson, scenario or dataset Gravitas has.",
      "anyOf": [
        {
          "$ref": "#/$defs/itemLesson"
        },
        {
          "$ref": "#/$defs/itemAssignment"
        },
        {
          "$ref": "#/$defs/itemScenario"
        },
        {
          "$ref": "#/$defs/itemDataset"
        },
        {
          "$ref": "#/$defs/itemReading"
        },
        {
          "$ref": "#/$defs/itemPack"
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "items"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/publicId"
        },
        "title": {
          "$ref": "#/$defs/text120"
        },
        "summary": {
          "$ref": "#/$defs/text2000"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    }
  }
}
