{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/scenario-pack-1.schema.json",
  "title": "gravitas.scenario-pack/1",
  "description": "A scenario as data: settings Gravitas understands, a seed, the instruments it opens with, and bodies as an orbital system or typed states, with text in every declared locale. Content only, never code. js/platform/scenario.js validateScenarioPack() is the authority: it also checks that every string is in every locale and free of markup, and that a pack with its own bodies generates no population. sdk/README.md, \"Scenario packs\".",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "locales",
    "title",
    "summary",
    "seed"
  ],
  "properties": {
    "format": {
      "const": "gravitas.scenario-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "en",
          "es"
        ]
      }
    },
    "title": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "enum": [
          "orbits-kepler",
          "solar-system",
          "exoplanets",
          "detection",
          "habitability",
          "binary-systems",
          "tides",
          "chaos",
          "stellar-evolution",
          "compact-objects",
          "relativity",
          "galaxies-clusters",
          "dark-matter",
          "resonance"
        ]
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravitational_constant": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10000
        },
        "mutual_gravity": {
          "type": "boolean"
        },
        "star_only_gravity": {
          "type": "boolean"
        },
        "integrator": {
          "enum": [
            "Symplectic Euler",
            "Velocity Verlet",
            "RK4"
          ]
        },
        "max_timestep": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "min_interaction_distance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "enable_star_merging": {
          "type": "boolean"
        },
        "bh_behavior": {
          "enum": [
            "Static",
            "Orbiting"
          ]
        },
        "orbit_decay_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "placement": {
          "enum": [
            "Circular",
            "Multi-Ring",
            "Random",
            "Grid",
            "Empty"
          ]
        },
        "sim_size": {
          "enum": [
            "Small",
            "Medium",
            "Large",
            "Huge"
          ]
        },
        "num_black_holes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "bh_mass": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000000000
        },
        "num_stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "num_neutron_stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "num_white_dwarfs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "num_planets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "num_gas_giants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "enable_asteroids": {
          "type": "boolean"
        },
        "num_asteroids": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "num_comets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "use_individual_bh_masses": {
          "type": "boolean"
        },
        "bh_masses": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1000000000
          }
        },
        "num_micro_stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "micro_star_high_velocity": {
          "type": "boolean"
        },
        "test_star_slingshot": {
          "type": "boolean"
        },
        "bh_layout": {
          "enum": [
            null,
            "parabolic-flyby"
          ]
        },
        "init_velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "velocity_stddev": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sim_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "show_trails": {
          "type": "boolean"
        },
        "trail_style": {
          "enum": [
            "Cloud",
            "Simple",
            "Glow"
          ]
        },
        "trail_length": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3000
        },
        "show_velocity_vectors": {
          "type": "boolean"
        },
        "show_acceleration_vectors": {
          "type": "boolean"
        },
        "show_potential_well": {
          "type": "boolean"
        },
        "show_scale_bar": {
          "type": "boolean"
        },
        "show_elapsed_time": {
          "type": "boolean"
        },
        "show_conservation_diagnostics": {
          "type": "boolean"
        },
        "star_density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "preset_zoom": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000
        },
        "bh_environment": {
          "enum": [
            "quiescent",
            "accreting",
            "jet"
          ]
        },
        "bh_disk_inclination": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "show_bh_glow": {
          "type": "boolean"
        },
        "show_accretion_disk": {
          "type": "boolean"
        },
        "show_bh_jets": {
          "type": "boolean"
        },
        "dynamic_object_properties": {
          "type": "boolean"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zoom"
      ],
      "properties": {
        "zoom": {
          "type": "number"
        },
        "pan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "paused": {
      "type": "boolean"
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inclination": {
          "type": "number"
        },
        "positionAngle": {
          "type": "number"
        }
      }
    },
    "open": {
      "type": "array",
      "items": {
        "enum": [
          "lightCurve",
          "radialVelocity",
          "rotationCurve",
          "astrometry",
          "pauseAtEvent",
          "view3d"
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "enum": [
          "ruler",
          "protractor",
          "stopwatch"
        ]
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodies"
      ],
      "properties": {
        "bodies": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "mass"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "Star",
                  "WhiteDwarf",
                  "NeutronStar",
                  "BlackHole",
                  "GasGiant",
                  "Planet"
                ]
              },
              "mass": {
                "type": "number"
              },
              "radius": {
                "type": "number"
              },
              "primary": {
                "type": "integer"
              },
              "a": {
                "type": "number"
              },
              "e": {
                "type": "number"
              },
              "omega": {
                "type": "number"
              },
              "phase": {
                "type": "number"
              },
              "retrograde": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "mass",
          "x",
          "y",
          "vx",
          "vy"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "Star",
              "WhiteDwarf",
              "NeutronStar",
              "BlackHole",
              "GasGiant",
              "Planet"
            ]
          },
          "mass": {
            "type": "number"
          },
          "radius": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "vx": {
            "type": "number"
          },
          "vy": {
            "type": "number"
          }
        }
      }
    }
  }
}
