{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/grid-1.schema.json",
  "title": "gravitas.grid/1",
  "description": "A precomputed table indexed by named parameters, with its generator and the exact inputs. The structure only; js/dataKinds/contract.js validateGrid() is the authority (it holds the axes to strict order, the cell count and the byte size to the bounds, and the data to the declared size). DATA_PACKS.md. FORMATS.md lists it.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "id",
    "axes",
    "outputs",
    "layout",
    "storage",
    "generator"
  ],
  "properties": {
    "format": {
      "const": "gravitas.grid"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "layout": {
      "enum": [
        "dense",
        "keyed"
      ]
    },
    "storage": {
      "type": "object",
      "properties": {
        "encoding": {
          "enum": [
            "float32-le",
            "float64-le"
          ]
        },
        "data": {
          "type": "string"
        },
        "part": {
          "$ref": "#/$defs/part"
        },
        "kind": {
          "const": "pack-table"
        },
        "pack": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "count"
        ],
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version",
        "inputs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  },
  "$defs": {
    "part": {
      "description": "A part (js/offlineParts.js): an immutable same-origin URL that carries the first 16 digits of its digest.",
      "type": "object",
      "required": [
        "id",
        "url",
        "sha256",
        "bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/[^?#:]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
