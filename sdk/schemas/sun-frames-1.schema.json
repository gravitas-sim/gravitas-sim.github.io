{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/sun-frames-1.schema.json",
  "title": "gravitas.sun-frames/1",
  "description": "The sidecar of the Sun's fourteen days, 4 to 17 May 2024, frames/sun-2024-05.json, which tools/sun-frames-build.mjs writes and js/sunWidgets.js and js/kernels/sun/sequence.js read: the sources and their credit, the rules the build followed, the sunspot groups and the marks placed on them by day, one row a day (the picture file with its size and SHA-256, the solar disc as fitted, the heliographic latitude and longitude of the disc centre, the position angles, the distance and the pixel scale) and the total solar irradiance by day. It is generated, and nothing checks its version, so the schema states what the generator writes. The prompt and part it was built under are recorded in it, and a day with no irradiance reading has a row with no value. FORMATS.md lists it.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "sources",
    "marks",
    "days"
  ],
  "properties": {
    "format": {
      "const": "gravitas.sun-frames"
    },
    "formatVersion": {
      "const": 1
    },
    "prompt": {
      "type": "integer"
    },
    "part": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "displayOnly": {
      "type": "string"
    },
    "northUp": {
      "type": "string"
    },
    "sources": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    },
    "groups": {
      "type": "object"
    },
    "marks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "marks"
        ],
        "properties": {
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "day"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "jd",
          "file",
          "bytes",
          "sha256",
          "width",
          "height",
          "disc"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "jd": {
            "type": "number"
          },
          "file": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "disc": {
            "type": "object",
            "required": [
              "centrePx",
              "radiusPx"
            ],
            "properties": {
              "centrePx": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "radiusPx": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "l0Deg": {
            "type": "number"
          },
          "b0Deg": {
            "type": "number"
          },
          "pSkyDeg": {
            "type": "number"
          },
          "pImageDeg": {
            "type": "number"
          },
          "distanceAu": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "arcsecPerPixel": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "minItems": 1
    },
    "irradiance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "jd"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "jd": {
            "type": "number"
          },
          "tsi1AuWm2": {
            "type": "number"
          },
          "sigmaWm2": {
            "type": "number"
          },
          "tsiEarthWm2": {
            "type": "number"
          },
          "provisional": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
