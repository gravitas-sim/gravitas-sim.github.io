{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/catalog-1.schema.json",
  "title": "gravitas.catalog/1",
  "description": "The curated catalog a reader browses at /catalog/ (catalog/catalog.json): the platform and languages it was made for, the lessons a course may name with their titles, and every entry, either a capability package built into Gravitas or a declarative extension served as a checksummed archive, with what it provides, its licenses, citations, offline policy and size, and for an archive its files, its review and its source. tools/catalog.mjs buildCatalog() writes it and `catalog check` holds the committed file to what it writes; js/catalogPage.js reads it and checks only the format and version, and refuses no field, so neither does this schema. The entries' provides, licenses and citations are the package manifest's (capability-package-1.schema.json). CATALOG.md describes it; FORMATS.md lists it.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "catalogVersion",
    "platform",
    "locales",
    "lessons",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "gravitas.catalog"
    },
    "formatVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "platform": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "en",
          "es"
        ]
      }
    },
    "lessons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "en"
        ],
        "additionalProperties": {
          "type": "string"
        },
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Every lesson id a course may name, with its title per language."
    },
    "entries": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "title": "a capability package built into Gravitas",
            "type": "object",
            "required": [
              "id",
              "version",
              "kind",
              "delivery",
              "title",
              "gravitas",
              "provides",
              "licenses",
              "citations",
              "offline",
              "bytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "kind": {
                "enum": [
                  "built-in",
                  "declarative"
                ]
              },
              "title": {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "gravitas": {
                "type": "string",
                "minLength": 1
              },
              "provides": {
                "type": "object"
              },
              "licenses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "scope",
                    "license"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string"
                    },
                    "license": {
                      "type": "string"
                    }
                  }
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "offline": {
                "enum": [
                  "precache",
                  "on-demand",
                  "online-only",
                  "none"
                ]
              },
              "bytes": {
                "type": "integer"
              },
              "delivery": {
                "const": "built-in"
              }
            }
          },
          {
            "title": "a declarative extension served as an archive",
            "type": "object",
            "required": [
              "id",
              "version",
              "kind",
              "delivery",
              "title",
              "gravitas",
              "provides",
              "licenses",
              "citations",
              "offline",
              "bytes",
              "type",
              "archiveFile",
              "sha256",
              "files",
              "unpackedBytes",
              "review",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "kind": {
                "enum": [
                  "built-in",
                  "declarative"
                ]
              },
              "title": {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "gravitas": {
                "type": "string",
                "minLength": 1
              },
              "provides": {
                "type": "object"
              },
              "licenses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "scope",
                    "license"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string"
                    },
                    "license": {
                      "type": "string"
                    }
                  }
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "offline": {
                "enum": [
                  "precache",
                  "on-demand",
                  "online-only",
                  "none"
                ]
              },
              "bytes": {
                "type": "integer"
              },
              "delivery": {
                "const": "archive"
              },
              "type": {
                "enum": [
                  "data-pack",
                  "course-pack"
                ]
              },
              "summary": {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "object": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "facility": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "archiveFile": {
                "type": "string",
                "pattern": "^packages/[a-z0-9.-]+-\\d+\\.\\d+\\.\\d+\\.gxp$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "unpackedBytes": {
                "type": "integer"
              },
              "review": {
                "type": "object",
                "required": [
                  "date",
                  "checks"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              },
              "source": {
                "type": "string",
                "pattern": "^extensions/"
              },
              "history": {
                "type": "array"
              }
            }
          }
        ]
      }
    }
  }
}
