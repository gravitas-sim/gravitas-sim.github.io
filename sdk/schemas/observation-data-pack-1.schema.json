{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/observation-data-pack-1.schema.json",
  "title": "gravitas.observation-data-pack/1",
  "description": "The record of a data pack: where the numbers came from and what was done to them. The structure only; tools/data-packs/schema.mjs validateDataPack() is the authority (it refuses synthetic data, restricted data, and a time series without a time system, among others). DATA_PACKS.md.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "title",
    "object",
    "facility",
    "dataType",
    "origin",
    "credit",
    "retrieved",
    "source",
    "license",
    "raw",
    "derived",
    "transformation",
    "columns",
    "masks",
    "assumptions",
    "reductions",
    "validation",
    "compatible",
    "offline"
  ],
  "properties": {
    "format": {
      "const": "gravitas.observation-data-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ra": {
          "type": "number"
        },
        "dec": {
          "type": "number"
        },
        "frame": {
          "type": "string"
        }
      }
    },
    "facility": {
      "type": "object",
      "required": [
        "observatory"
      ]
    },
    "dataType": {
      "enum": [
        "light-curve",
        "radial-velocity",
        "spectrum",
        "strain",
        "model-grid",
        "system-parameters",
        "rotation-curve"
      ]
    },
    "origin": {
      "enum": [
        "observed",
        "model",
        "compilation",
        "synthetic"
      ]
    },
    "credit": {
      "type": "string",
      "minLength": 1
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "urls",
        "citations"
      ],
      "properties": {
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "status",
        "statement"
      ],
      "properties": {
        "status": {
          "enum": [
            "public-domain",
            "cc0",
            "cc-by-4.0",
            "attribution-requested",
            "no-license-stated",
            "restricted"
          ]
        },
        "statement": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "raw": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "url",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical": {
            "enum": [
              "data-lines"
            ]
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "transformation": {
      "type": "object",
      "required": [
        "script",
        "version",
        "steps"
      ],
      "properties": {
        "script": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "time": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "uncertaintyOf": {
            "type": "string"
          }
        }
      }
    },
    "masks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "column",
          "rule"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reductions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "check",
        "against"
      ],
      "properties": {
        "check": {
          "type": "string"
        },
        "against": {
          "type": "array",
          "minItems": 1
        },
        "rule": {
          "type": "object",
          "required": [
            "kind"
          ]
        }
      }
    },
    "compatible": {
      "type": "object",
      "properties": {
        "widgets": {
          "type": "array"
        },
        "investigations": {
          "type": "array"
        }
      }
    },
    "offline": {
      "enum": [
        "core",
        "optional",
        "none"
      ]
    }
  }
}
