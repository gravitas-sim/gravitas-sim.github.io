{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitas-sim.online/sdk/schemas/investigation-pack-1.schema.json",
  "title": "gravitas.investigation-pack/1",
  "description": "A guided investigation as data: the data part of a lesson, with the step types the engine runs (read, predict, explore, measure, question) and the answer checks it has, and no code. A prediction is held and marked at a later step; a question is inline or drawn from the pack's bank (question-bank-1.schema.json, whose $defs these share); any step may be remediation on an earlier graded one, one level deep. js/platform/investigation.js validateInvestigationPack() is the authority. Beyond this schema it holds every step id unique and every step a pack names (requires, reveal, when, from) to one that exists in the right place, an option's answer to its options, the last step to a read or explore step, each text to the pack's own locales, and, before any rule reads it, a file to plain data no deeper or larger than any pack needs. The scenarios, instruments and lessons named are this build's. FORMATS.md lists it.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "locales",
    "title",
    "subtitle",
    "summary",
    "level",
    "duration",
    "seed",
    "objectives",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "gravitas.investigation-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "description": "A public id, not one of a lesson Gravitas already has.",
      "$ref": "#/$defs/publicId",
      "not": {
        "enum": [
          "keplers-laws",
          "retrograde-motion",
          "transit-photometry",
          "orbital-energy",
          "weighing-stars",
          "black-holes",
          "radial-velocity",
          "goldilocks-question",
          "missing-mass",
          "tides",
          "butterfly-effect",
          "when-orbits-lock",
          "detect-this-planet",
          "design-the-schedule",
          "binary-star-planets",
          "gravity-assist",
          "hohmann-transfer",
          "lagrange-points",
          "what-is-a-gravitational-wave",
          "listening-to-spacetime",
          "a-universe-of-stars",
          "lives-of-stars",
          "twelve-nights",
          "power-law-gravity"
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locales": {
      "type": "array",
      "contains": {
        "const": "en"
      },
      "items": {
        "enum": [
          "en",
          "es"
        ]
      }
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "subtitle": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "level": {
      "$ref": "#/$defs/text"
    },
    "duration": {
      "description": "A range such as \"20-25 min\".",
      "type": "string",
      "pattern": "^\\d+(-\\d+)?\\s*min$"
    },
    "thumbnail": {
      "description": "The scenario whose picture the card shows: its id, or the English name a pack made before ids names it by.",
      "enum": [
        "solar-system",
        "retrograde-mars",
