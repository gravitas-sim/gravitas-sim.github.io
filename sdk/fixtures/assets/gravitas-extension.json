{
  "format": "gravitas.capability-package",
  "formatVersion": 1,
  "id": "fixture.assets",
  "version": "1.0.0",
  "kind": "declarative",
  "gravitas": "^1.0.0",
  "title": {
    "en": "Finding exoplanets: a five-lesson sequence",
